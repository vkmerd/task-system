// Dijital pazarlama ajansi - is takip & kaynak yonetim sistemi
// Veritabani: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Kimlik & yetki
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

/// Adminler tek tip degil: her admin tipi farkli bir panel duzeni ve farkli
/// varsayilan yetki setiyle acilir.
enum AdminType {
  SUPER_ADMIN // her seye erisir, sistem ayarlari
  OPERATIONS_ADMIN // is dagilimi, kapasite, teslim takibi
  FINANCE_ADMIN // sozlesme, fatura, karlilik, maliyet
  SALES_ADMIN // musteri kazanimi, teklif, pipeline
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         Role
  status       UserStatus @default(ACTIVE)

  /// Sadece role = ADMIN icin dolu. Panelin hangi duzende acilacagini belirler.
  adminType AdminType?

  /// Rol varsayilanlarinin uzerine eklenen ekstra yetkiler (permissions.ts)
  extraPermissions  String[] @default([])
  /// Rol varsayilanlarindan cikarilan yetkiler
  deniedPermissions String[] @default([])

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  employeeProfile EmployeeProfile?
  customerContact CustomerContact?

  refreshTokens     RefreshToken[]
  managedCustomers  Customer[]         @relation("AccountManager")
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     Task[]             @relation("TaskAssignee")
  reviewTasks       Task[]             @relation("TaskReviewer")
  taskWatches       TaskWatcher[]
  comments          TaskComment[]
  attachments       TaskAttachment[]
  timeLogs          TimeLog[]
  activities        TaskActivity[]
  notifications     Notification[]
  ownedProjects     Project[]          @relation("ProjectOwner")
  customerTeamSeats CustomerTeamSeat[]

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Calisanlar: departman + unvan
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#1976d2")
  createdAt DateTime @default(now())

  jobTitles JobTitle[]
  employees EmployeeProfile[]

  @@map("departments")
}

/// Unvan tablosu: "SEO Uzmani", "Sanat Yonetmeni" gibi kayitlar admin tarafindan
/// yonetilebilsin diye enum yerine tablo olarak tutuluyor.
model JobTitle {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  /// Kidem sirasi: 1 = junior ... 5 = director. Raporlama ve ucret hesabinda kullanilir.
  level        Int      @default(2)
  createdAt    DateTime @default(now())

  department Department        @relation(fields: [departmentId], references: [id])
  employees  EmployeeProfile[]

  @@unique([name, departmentId])
  @@map("job_titles")
}

model EmployeeProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  jobTitleId   String
  departmentId String
  employeeCode String? @unique

  /// Haftalik calisilabilir saat. Kapasite/doluluk hesabinin temeli.
  weeklyCapacityHours Int      @default(40)
  workMode            WorkMode @default(HYBRID)
  /// Ajansa saatlik maliyeti (ic maliyet, karlilik raporunda kullanilir)
  hourlyCost          Float    @default(0)

  hireDate DateTime?
  skills   String[]  @default([])
  bio      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTitle   JobTitle   @relation(fields: [jobTitleId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("employee_profiles")
}

// ---------------------------------------------------------------------------
// Musteriler
// ---------------------------------------------------------------------------

enum CustomerStatus {
  PROSPECT
  ACTIVE
  PAUSED
  CHURNED
}

enum ServiceType {
  SEO
  GOOGLE_ADS
  META_ADS
  SOCIAL_MEDIA
  CONTENT
  DESIGN
  WEB_DEVELOPMENT
  EMAIL_MARKETING
  INFLUENCER
  PR
  ANALYTICS
  OTHER
}

model Customer {
  id          String         @id @default(cuid())
  companyName String
  legalName   String?
  slug        String         @unique
  taxNumber   String?
  taxOffice   String?
  sector      String?
  website     String?
  logoUrl     String?
  status      CustomerStatus @default(PROSPECT)

  contractStartDate DateTime?
  contractEndDate   DateTime?
  /// Aylik sabit hizmet bedeli (retainer)
  monthlyRetainer   Float     @default(0)
  currency          String    @default("TRY")
  /// Aylik sozlesmeye dahil is saati. Asildiginda operasyon admini uyarilir.
  contractedHours   Int       @default(0)

  /// Musteri iliskisinden sorumlu kisi (genelde musteri temsilcisi)
  accountManagerId String?

  /// 0-100 arasi musteri saglik skoru (gecikme, revizyon, NPS vb. ile guncellenir)
  healthScore Int     @default(70)
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accountManager User?              @relation("AccountManager", fields: [accountManagerId], references: [id])
  services       CustomerService[]
  contacts       CustomerContact[]
  team           CustomerTeamSeat[]
  projects       Project[]
  tasks          Task[]

  @@index([status])
  @@index([accountManagerId])
  @@map("customers")
}

/// Musterinin satin aldigi hizmet kalemleri. Is dagilimi bu kalemler uzerinden yapilir.
model CustomerService {
  id            String      @id @default(cuid())
  customerId    String
  serviceType   ServiceType
  monthlyBudget Float       @default(0)
  /// Bu hizmet icin ayda ayrilan saat
  monthlyHours  Int         @default(0)
  isActive      Boolean     @default(true)
  notes         String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@unique([customerId, serviceType])
  @@map("customer_services")
}

/// Musteri tarafindaki kisiler. Panele giris yapacaklar bir User kaydina baglanir.
model CustomerContact {
  id         String  @id @default(cuid())
  customerId String
  userId     String? @unique

  fullName  String
  email     String
  phone     String?
  position  String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_contacts")
}

/// Hangi calisanin hangi musteride, hangi rolde calistigi.
/// Admin is atamasini bu kadro uzerinden yapar; calisan da sadece kadroda oldugu
/// musterileri gorur.
model CustomerTeamSeat {
  id             String       @id @default(cuid())
  customerId     String
  userId         String
  /// Bu kisinin musteride hangi hizmetten sorumlu oldugu (bos = genel)
  service        ServiceType?
  /// Ayda bu musteriye ayrilan saat (kapasite planlamasi)
  allocatedHours Int          @default(0)
  isLead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId, service])
  @@index([userId])
  @@map("customer_team_seats")
}

// ---------------------------------------------------------------------------
// Projeler & isler
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  customerId  String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  color       String        @default("#5c6bc0")

  startDate   DateTime?
  dueDate     DateTime?
  budgetHours Int       @default(0)
  ownerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner    User?    @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks    Task[]

  @@index([customerId, status])
  @@map("projects")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  REVISION
  WAITING_CUSTOMER
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String  @id @default(cuid())
  /// Insan okunur is kodu: ACME-142
  code        String  @unique
  title       String
  description String?

  customerId String
  projectId  String?
  serviceId  String?

  createdById String
  assigneeId  String?
  /// Isi onaylayacak kisi (genelde takim lideri veya musteri temsilcisi)
  reviewerId  String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  estimatedHours Float?
  startDate      DateTime?
  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  /// Kanban sutunu icindeki sira
  position            Int     @default(0)
  isBillable          Boolean @default(true)
  /// Musteri bu isi panelinde gorsun mu
  isVisibleToCustomer Boolean @default(true)
  revisionCount       Int     @default(0)

  tags String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  service   CustomerService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignee  User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewer  User?            @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  checklist   TaskChecklistItem[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  timeLogs    TimeLog[]
  activities  TaskActivity[]
  watchers    TaskWatcher[]

  @@index([customerId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@map("tasks")
}

model TaskChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  title    String
  isDone   Boolean @default(false)
  position Int     @default(0)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskWatcher {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_watchers")
}

model TaskComment {
  id         String  @id @default(cuid())
  taskId     String
  authorId   String
  body       String
  /// true ise musteri bu yorumu goremez (ic yazisma)
  isInternal Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id           String  @id @default(cuid())
  taskId       String
  uploadedById String
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?

  createdAt DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

/// Calisilan sureler. Hem kapasite hem de musteri karliligi buradan hesaplanir.
model TimeLog {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  minutes    Int
  workDate   DateTime @db.Date
  note       String?
  isBillable Boolean  @default(true)

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workDate])
  @@index([taskId])
  @@map("time_logs")
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  COMMENTED
  ATTACHMENT_ADDED
  TIME_LOGGED
  REVISION_REQUESTED
  COMPLETED
  REOPENED
  UPDATED
}

model TaskActivity {
  id      String       @id @default(cuid())
  taskId  String
  actorId String
  type    ActivityType
  /// { field, from, to } gibi serbest yapida detay
  meta    Json?

  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_activities")
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_STATUS_CHANGED
  REVISION_REQUESTED
  MENTIONED
  SYSTEM
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  title  String
  body   String?
  /// Panel ici yonlendirme adresi: /tasks/<id>
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Is kodu (ACME-142) uretmek icin musteri bazli sayac.
model TaskCounter {
  customerId String @id
  prefix     String
  lastNumber Int    @default(0)

  @@map("task_counters")
}
