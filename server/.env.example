# --- Veritabani (Neon) ---------------------------------------------------
# Neon konsolunda "Connection string" > "Prisma" sekmesinden kopyalanir.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- Sunucu --------------------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- JWT -----------------------------------------------------------------
# Uretim icin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=degistir-bu-degeri-access-token-icin-uzun-rastgele-bir-dize
JWT_REFRESH_SECRET=degistir-bu-degeri-refresh-token-icin-farkli-uzun-rastgele-bir-dize
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Ilk kurulum ---------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ajans.com
SEED_ADMIN_PASSWORD=Admin123!
